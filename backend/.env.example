# Copy this file to .env.local and replace the placeholders.
PORT=5000
FRONTEND_URL=http://localhost:5173

# Paste the PostgreSQL connection string (for example from a Neon project).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-generated-random-secret"
JWT_EXPIRES_IN=1h

# Timezone used to decide what "today" is for service due dates.
TIMEZONE=Africa/Lagos

# Optional. Public OAuth client id for "Continue with Google" (Google Cloud, Web application).
# GOOGLE_CLIENT_ID=
