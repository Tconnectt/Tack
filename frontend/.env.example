# Backend address (no /api at the end). Restart Vite after changing this.
VITE_API_URL=http://localhost:5000

# IANA timezone used to decide what "today" is when recording service work.
# Keep it the same as TIMEZONE on the backend.
VITE_TIMEZONE=Africa/Lagos

# Optional. Public Google OAuth client id. Shows the "Continue with Google" button when set.
# VITE_GOOGLE_CLIENT_ID=
